<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical">

    <!-- ========== 渐变搜索栏（虎码 logo + 菜单） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_gradient_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <!-- 虎码 logo：虎字黄色，码字黑色 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="0dp"
            android:text="虎助手"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/zhhhelper_fonts" />

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="菜单"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <!-- ========== 主内容区（可滚动） ========== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="32dp">

            <!-- 标题：🐯虎码拆分查询： -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🐯虎码拆分查询："
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/zhhhelper_fonts" />

            <!-- 搜索框 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp"
                    android:fontFamily="@font/zhhhelper_fonts" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="输入要查询的字"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="18sp"
                    android:fontFamily="@font/zhhhelper_fonts" />

                <ImageButton
                    android:id="@+id/btn_clear"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="清除"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/text_hint"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ========== 结果区（默认隐藏） ========== -->
            <LinearLayout
                android:id="@+id/result_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 结果标题栏：查询结果 + 字体加减 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="查询结果："
                        android:textColor="@color/text_secondary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/zhhhelper_fonts" />

                    <ImageButton
                        android:id="@+id/btn_font_minus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="减小字体"
                        android:src="@drawable/ic_minus"
                        android:tint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/btn_font_plus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="增大字体"
                        android:src="@android:drawable/ic_menu_add"
                        android:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- 结果卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_result_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- 字头 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="字头："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/tv_char"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- 编码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="编码："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/tv_codes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/code_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- 拆分（含上方小字根码） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="拆分："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 字根编码小字（如 Rk Nw Id） -->
                            <TextView
                                android:id="@+id/tv_root_codes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_hint"
                                android:textSize="14sp"
                                android:visibility="gone"
                                android:fontFamily="@font/zhhhelper_fonts" />

                            <!-- 拆分部件（如 囗 王 丶） -->
                            <TextView
                                android:id="@+id/tv_components"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:fontFamily="@font/zhhhelper_fonts" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 拼音 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="拼音："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/tv_pinyin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- U码 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="U 码："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/tv_unicode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- 整句码 -->
                    <LinearLayout
                        android:id="@+id/row_zheng"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="整句码："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/tv_zheng_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/code_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- 字统链接 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="字统："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/btn_zitong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查看字统"
                            android:textColor="@color/link_blue"
                            android:textSize="18sp"
                            android:background="@drawable/bg_link_underline"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                    <!-- 叶典链接 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="叶典："
                            android:textColor="@color/text_secondary"
                            android:textSize="18sp"
                            android:fontFamily="@font/zhhhelper_fonts" />

                        <TextView
                            android:id="@+id/btn_yedian"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查看叶典"
                            android:textColor="@color/link_blue"
                            android:textSize="18sp"
                            android:background="@drawable/bg_link_underline"
                            android:fontFamily="@font/zhhhelper_fonts" />
                    </LinearLayout>

                </LinearLayout>
                <!-- /结果卡片 -->

                <!-- 底部留白 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />
            </LinearLayout>
            <!-- /结果区 -->

        </LinearLayout>
        <!-- /主内容垂直布局 -->

    </ScrollView>
    <!-- /主内容区 -->

</LinearLayout>
