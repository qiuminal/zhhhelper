<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_white"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="返回" android:src="@drawable/ic_arrow_back" android:tint="@color/text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="文章" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <ImageView android:layout_width="28dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:contentDescription="beta" android:src="@drawable/ic_tag_beta" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_light" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <!-- 左侧预留扩展按钮空间，字号按钮固定在最右侧 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/btn_paste_text" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_button_primary" android:gravity="center" android:paddingHorizontal="14dp" android:text="粘贴" android:textColor="@android:color/white" android:textSize="13sp" />
            <TextView android:id="@+id/btn_import_text" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="导入" android:textColor="@color/code_blue" android:textSize="13sp" />
            <TextView android:id="@+id/btn_restart" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="14dp" android:text="重打" android:textColor="@color/code_blue" android:textSize="13sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/btn_font_minus" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_circle_button" android:contentDescription="减小字号" android:src="@drawable/ic_remove" android:tint="@color/text_secondary" />
            <ImageButton android:id="@+id/btn_font_plus" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/bg_circle_button" android:contentDescription="增大字号" android:src="@drawable/ic_add" android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_article_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="欢迎使用虎助手" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tv_char_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <!-- 字帖固定为上一版高度的 90%，节省空间留在成绩区下方 -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="40.5">
            <ScrollView android:id="@+id/scroll_reference" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_result_card" android:fillViewport="true" android:paddingLeft="8dp" android:paddingTop="14dp" android:paddingRight="8dp" android:paddingBottom="14dp">
                <com.qiuminal.zhhhelper.ArticleCopybookView android:id="@+id/tv_reference" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="120dp" />
            </ScrollView>
            <EditText android:id="@+id/et_article_input" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@null" android:cursorVisible="false" android:imeOptions="flagNoExtractUi" android:importantForAutofill="no" android:inputType="textMultiLine|textNoSuggestions" android:longClickable="false" android:textColor="@android:color/transparent" android:textIsSelectable="false" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tv_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="计时 00:00" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tv_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="0 字/分" android:textColor="@color/text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tv_progress" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0 / 0" android:textColor="@color/code_blue" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- 成绩区：权重增至 39.5 容纳表头+8行+翻页行+上下 padding，留白归零 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="37" android:background="@drawable/bg_result_card" android:orientation="vertical" android:padding="10dp">
            <!-- 表格：外框浅灰描边，表头与数据行之间用横线分隔，行内用竖线分列 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_result_table" android:divider="@drawable/divider_result_h" android:orientation="vertical" android:showDividers="middle">
                <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:background="#F5F7FA" android:divider="@drawable/divider_result_v" android:gravity="center_vertical" android:orientation="horizontal" android:showDividers="middle">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:gravity="center" android:text="标题" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.75" android:gravity="center" android:text="速度" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.65" android:gravity="center" android:text="字数" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.7" android:gravity="center" android:text="错字" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:gravity="center" android:text="用时" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.35" android:gravity="center" android:text="时间" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/result_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@drawable/divider_result_h" android:orientation="vertical" android:showDividers="middle" />
            </LinearLayout>
            <!-- 翻页行：wrap_content 高度，避免固定 30dp 在空间不足时把底部 padding 挤爆导致按钮溢出卡片底边 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/btn_result_prev" android:layout_width="64dp" android:layout_height="28dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="上一页" android:textColor="@color/code_blue" android:textSize="13sp" />
                <TextView android:id="@+id/btn_result_next" android:layout_width="64dp" android:layout_height="28dp" android:layout_marginStart="12dp" android:background="@drawable/bg_chip" android:gravity="center" android:text="下一页" android:textColor="@color/code_blue" android:textSize="13sp" />
                <TextView android:id="@+id/tv_result_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="1 / 1" android:textColor="@color/text_secondary" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" />
    </LinearLayout>
</LinearLayout>
