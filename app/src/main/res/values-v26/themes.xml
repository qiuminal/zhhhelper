<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        API 26+ 主题：把全局字体族（TumanPUA → 霞鹜文楷 → 遍黑体 P1 → P2）
        挂到主题级 android:fontFamily，所有控件默认继承。
        低版本（API 23-25）由布局中的 android:fontFamily 属性
        （AppCompat + TextViewCompat 处理）与 AppFonts 字符级回退兜底。
    -->
    <style name="Theme.ZhhHelper.Fonts">
        <item name="android:fontFamily">@font/zhhhelper_fonts</item>
    </style>
</resources>
