<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        全局字体族（fallback 顺序）：
        1) TumanPUA          虎码私有区部件
        2) LXGW WenKai GB Screen 霞鹜文楷屏幕阅读版（常用汉字）
        3) Plangothic P1    遍黑体 P1（CJK 扩展 B-F）
        4) Plangothic P2    遍黑体 P2（CJK 扩展 G）
    -->
    <font
        android:font="@font/tuman_pua"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/lxgw_wenkai_screen"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/plangothic_p1"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/plangothic_p2"
        android:fontStyle="normal"
        android:fontWeight="400" />
</font-family>
